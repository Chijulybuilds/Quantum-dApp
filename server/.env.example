# Conclave relayer. TESTNET ONLY. Never commit .env.
# One BIP-39 mnemonic; accounts by index: 0 relayer/deployer, 1 demo member A, 2 demo member B, 3 guardian.
CONCLAVE_MNEMONIC=
# The team member's QoreX account that joins the demo DAO (needs an ML-DSA-87 key on chain).
CONCLAVE_FOUNDER=0x8cb8f8C8aF2E98c4a952228344522126FA907c7F
# Set after deployment (otherwise read from contracts/deployments/testnet.json).
CONCLAVE_ADDRESS=
PORT=8787
# Origins allowed to call the API (the app), comma-separated.
APP_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Demo members sign on request (testnet demo DAO only). Set to false for a real DAO.
DEMO_MODE=true
