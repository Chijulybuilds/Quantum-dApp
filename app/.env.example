# Relayer API. Leave empty in development: Vite proxies /api to http://localhost:8787.
VITE_API_URL=
# Deployed Conclave address (optional: the app also reads it from the relayer).
VITE_CONCLAVE_ADDRESS=
# WalletConnect Cloud project id (only needed for WalletConnect-based wallets).
VITE_WALLETCONNECT_PROJECT_ID=
