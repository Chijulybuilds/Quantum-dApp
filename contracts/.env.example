# Conclave scripts configuration. Copy to .env and fill in. NEVER commit .env.
# Only the testnet (qorechain-diana) has the PQC precompiles Conclave needs.
QORE_NETWORK=testnet

# ---- Default account (deployer, and relayer/member unless set below) ---------------------------
# Either a BIP-39 mnemonic (the ML-DSA-87 key is derived from it, like QoreX) ...
QORE_MNEMONIC=
QORE_ACCOUNT_INDEX=0
# ... or a private key plus a QRC1 PQC recovery code (`npm run window recovery-code`).
PRIVATE_KEY=
QORE_PQC_RECOVERY_CODE=

# ---- Optional separate roles -----------------------------------------------------------------
# The member whose ML-DSA-87 key signs proposals and votes (e.g. each teammate on their machine).
MEMBER_MNEMONIC=
# The relayer only pays gas, from an EVM window scoped to Conclave. It carries no authority.
RELAYER_MNEMONIC=

# ---- Deployment (npm run deploy:testnet) -----------------------------------------------------
# Comma-separated member addresses (0x... or qor1...); each needs an ML-DSA-87 key on chain.
CONCLAVE_MEMBERS=
# FOR votes needed: a strict majority (2 of 3, 3 of 4 or 5, ...).
CONCLAVE_THRESHOLD=2
# Optional: an account allowed to pause payouts once.
CONCLAVE_GUARDIAN=
# Seconds. Defaults: 1 day voting, 10 min timelock (demo), 7 days grace, 1 day pause.
CONCLAVE_VOTING_PERIOD=86400
CONCLAVE_TIMELOCK=600
CONCLAVE_GRACE_PERIOD=604800
CONCLAVE_PAUSE_DURATION=86400

# ---- After deployment ------------------------------------------------------------------------
CONCLAVE_ADDRESS=
CONCLAVE_DEPLOY_BLOCK=

# ---- Optional ---------------------------------------------------------------------------------
# Window size for `npm run window open|open-scoped`.
QORE_WINDOW_BLOCKS=600
QORE_WINDOW_TXS=5
# Your own nodes instead of the public endpoints (rate limited per IP).
QORE_REST_URL=
QORE_RPC_URL=
QORE_EVM_RPC_URL=
