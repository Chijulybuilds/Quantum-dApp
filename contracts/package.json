{
  "name": "conclave-contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Conclave: a DAO treasury on QoreChain whose sensitive actions need ML-DSA-87 (post-quantum) signatures.",
  "license": "MIT",
  "scripts": {
    "build": "forge build --sizes",
    "test": "forge test",
    "test:ffi": "FOUNDRY_PROFILE=ffi forge test",
    "test:ci": "FOUNDRY_PROFILE=ci forge test",
    "coverage": "forge coverage --ir-minimum --report summary --no-match-coverage '(test|script)/'",
    "gas": "forge snapshot --no-match-path 'test/invariant/*'",
    "window": "tsx --env-file=.env scripts/window.ts",
    "deploy:testnet": "tsx --env-file=.env scripts/deploy.ts",
    "conclave": "tsx --env-file=.env scripts/conclave.ts",
    "sign-message": "tsx --env-file=.env scripts/sign-message.ts",
    "pqc:check": "tsx --env-file=.env scripts/pqc-check.ts",
    "export-abi": "tsx scripts/export-abi.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@cosmjs/stargate": "^0.39.0",
    "@qorechain/evm": "^0.14.0",
    "@qorechain/qoresign": "^0.2.0",
    "@qorechain/sdk": "^0.14.0",
    "viem": "~2.53.1"
  },
  "devDependencies": {
    "@types/node": "^22.7.5",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3"
  }
}
